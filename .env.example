# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# In CI the same keys come from GitHub Actions variables / secrets.
# NOTE: wrap values containing # or spaces in quotes, e.g. ADMIN_PASSWORD="abc#123"
#       (unquoted, everything after # is treated as a comment)
# ---------------------------------------------------------------

# Which project profile to load from ./projects/<PROJECT>.ts
PROJECT=wecycle

# Storefront base URL (required — profiles contain no URL), without trailing slash
BASE_URL=

# Optional HTTP basic auth (staging environments behind .htaccess)
HTTP_USERNAME=
HTTP_PASSWORD=

# --- Admin API (test data setup + cleanup of test customers) ------
# Preferred: an integration (Settings > System > Integrations, with admin rights)
ADMIN_CLIENT_ID=
ADMIN_CLIENT_SECRET=
# Alternative: a dedicated test admin user (password grant)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Store API ---------------------------------------------------
# Sales channel access key. Empty = resolved automatically via the Admin API.
SW_ACCESS_KEY=

# --- Test customers ----------------------------------------------
# Password for every customer the suite registers (overrides the profile).
# Must meet the shop's password rules (min. 8 characters).
NEW_ACCOUNT_PASSWORD=

# Valid, unlimited promotion code for the "valid promotion code" test (overrides the profile).
# Empty = that test is skipped.
PROMOTION_CODE=

# --- Switches ----------------------------------------------------
# false = skip tests that create customers, place orders or submit forms
ALLOW_WRITE_TESTS=true
# Delete customers created by the tests afterwards (needs Admin API)
CLEANUP_TEST_DATA=true

# Browsers to run in addition to chromium + mobile: firefox,webkit
EXTRA_BROWSERS=
